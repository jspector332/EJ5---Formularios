@{
    ViewData["Title"] = "Home Page";
}

<form action = '@Url.Action("Verificar", "Home")' method ="post">
    <h2>Datos personales</h2>
    Nombre completo: <input type="text" name="Nombre"></br>
    Edad: <input type="number" name="edad"></br>
    DNI: <input type="number" name="dni"></br>
    <h2>Situación laboral</h2>
    ¿Actualmente trabaja?: <input type="radio" name="estadoLaboral" value="si"> Si
                           <input type="radio" name="estadoLaboral" value="no"> No</br>
    Tipo de empleo: <select name="tipoEmpleo">
        <option value="1"> Relacion de dependencia </option>
        <option value="2"> Monotributita </option>
        <option value="3"> Autonomo </option>
        <option value="4"> Desempleado </option>
        </select>
    <h2>Informacion economica</h2>
     Ingreso mensual: <input type="number" name="ingresoEconomico"></br>
     ¿Posee deudas?: <input type="radio" name="poseeDeudas" value="si"> Si</br>
     <input type="radio" name="poseeDeudas" value="no"> No</br>
     Seleccione cuales: 
        <input type="checkbox" name="tarjetaCredito"> Tarjeta de credito
        <input type="checkbox" name="prestamoBancario"> Prestamo bancario
        <input type="checkbox" name="prestamoInformal"> Prestamo informal
    <h2> Condiciones del prestamo</h2>
    Monto solicitado: <input type="number" name="monto"></br>
    Plazo de devolucion: <select name="plazoDevolucion">
     <option value="1"> 6 Meses </option>
     <option value="2"> 12 Meses </option>
     <option value="3"> 24 Meses </option>
     </select>
     <h2>Confirmacion de terminos y condiciones</h2>
     <input type="radio" name="confirmacion" value="aceptar"> Aceptar</br>
     <input type="radio" name="confirmacion" value="rechazar"> Rechazar</br>
     <input type="submit" value="Entregar">
     <input type="reset"value="Reiniciar">
     </form>

    

